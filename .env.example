# Environment variables for Docker deployment
# Copy this to .env and fill in production values

# Database
DATABASE_URL=postgresql://ngcs:ngcs@db:5432/ngcs

# Backend
JWT_SECRET=
NODE_ENV=production
PERSISTENT_SESSIONS_ENABLED=false
# Exact approved frontend origin; HTTPS is required when enabled in production.
FRONTEND_ORIGIN=

# Account delivery. Production accepts smtp only; provider and real values are TBD.
ACCOUNT_DELIVERY_MODE=smtp
ACCOUNT_PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TIMEOUT_MS=10000
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Tactical V2: keep false until scene editor/integration gates and explicit rollout.
TACTICAL_V2_WRITES_ENABLED=false

# Frontend
VITE_API_BASE_URL=http://localhost:4000
VITE_PERSISTENT_SESSIONS_ENABLED=false

# Browser E2E values belong to a disposable test environment only.
E2E_DATABASE_URL=
E2E_ALLOW_DESTRUCTIVE_RESET=false
E2E_COACH_EMAIL=coach.e2e@example.test
E2E_COACH_PASSWORD=
