# Environment variables for Docker deployment
# Copy this to .env and fill in production values

# Database
DATABASE_URL=postgresql://ngcs:ngcs@db:5432/ngcs

# Backend
JWT_SECRET=
NODE_ENV=production
PERSISTENT_SESSIONS_ENABLED=false
# Exact approved frontend origin; HTTPS is required when enabled in production.
FRONTEND_ORIGIN=

# Frontend
VITE_API_BASE_URL=http://localhost:4000
VITE_PERSISTENT_SESSIONS_ENABLED=false

# Browser E2E values belong to a disposable test environment only.
E2E_DATABASE_URL=
E2E_ALLOW_DESTRUCTIVE_RESET=false
E2E_COACH_EMAIL=coach.e2e@example.test
E2E_COACH_PASSWORD=
