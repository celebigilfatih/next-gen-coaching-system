# Development Dockerfile for Next.js Frontend with Hot Reload
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source (will be overridden by volume mount)
COPY . .

# Build arguments
ARG NEXT_PUBLIC_API_URL=http://localhost:9001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Expose port
EXPOSE 3000

# Start Next.js in development mode with hot reload
CMD ["npm", "run", "dev"]
