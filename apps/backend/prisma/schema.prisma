generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String               @id @default(cuid())
  name                       String
  email                      String               @unique
  passwordHash               String
  role                       UserRole
  status                     AccountStatus        @default(ACTIVE)
  authVersion                Int                  @default(0)
  clubId                     String?
  personId                   String?              @unique
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  birthDate                  DateTime?
  position                   Position?
  attendances                Attendance[]
  groups                     GroupMember[]
  playerLoads                PlayerLoad[]         @relation("PlayerLoads")
  performances               PlayerPerformance[]
  seasonsCreated             Season[]             @relation("SeasonCreator")
  coachedPlans               TrainingPlan[]
  healthLogs                 PlayerHealthLog[]    @relation("PlayerHealthLogs")
  healthStatus               PlayerHealthStatus[] @relation("PlayerHealthStatus")
  coachNotes                 PlayerCoachNote[]    @relation("PlayerCoachNotes")
  invitationsCreated         AccountInvitation[]  @relation("InvitationCreator")
  invitationAccepted         AccountInvitation?   @relation("InvitationAcceptedUser")
  passwordResetsCreated      PasswordResetToken[] @relation("PasswordResetCreator")
  passwordResetTokens        PasswordResetToken[] @relation("PasswordResetTarget")
  auditEventsAuthored        SecurityAuditEvent[] @relation("AuditActor")
  auditEventsTargeted        SecurityAuditEvent[] @relation("AuditTarget")
  drillsCreated              Drill[]              @relation("DrillCreator")
  drillVersionsAuthored      DrillVersion[]       @relation("DrillVersionAuthor")
  drillVersionsReviewed      DrillVersion[]       @relation("DrillVersionReviewer")
  drillVersionsPublished     DrillVersion[]       @relation("DrillVersionPublisher")
  drillSourcesVerified       DrillSource[]        @relation("DrillSourceVerifier")
  refreshSessions            RefreshSession[]
  club                       Club?                @relation(fields: [clubId], references: [id])
  person                     Person?              @relation(fields: [personId], references: [id], onDelete: SetNull)
  sportingAssignmentsCreated SportingAssignment[] @relation("SportingAssignmentCreator")
  playerNotesAuthored          PlayerNote[]         @relation("PlayerNoteAuthor")
  playerNoteRevisions          PlayerNoteRevision[] @relation("PlayerNoteRevisionEditor")
  playerNoteGrantsCreated      PlayerNoteTeamGrant[] @relation("PlayerNoteGrantActor")

  @@index([personId])
}

model Club {
  id                  String               @id @default(cuid())
  name                String
  logo                String?
  description         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  groups              PlayerGroup[]
  seasons             Season[]
  plans               TrainingPlan[]
  users               User[]
  invitations         AccountInvitation[]
  auditEvents         SecurityAuditEvent[]
  drills              Drill[]
  persons             Person[]
  teams               Team[]
  clubSeasons         ClubSeason[]
  functionalRoles     FunctionalRole[]
  sportingAssignments SportingAssignment[]
  externalIdentities  ExternalIdentity[]
  availabilityPeriods AvailabilityPeriod[]
  teamSeasons         TeamSeason[]
  playerNotes         PlayerNote[]
}

model Person {
  id                  String               @id @default(cuid())
  clubId              String
  displayName         String
  birthDate           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  club                Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  account             User?
  playerProfile       PlayerProfile?
  staffProfile        StaffProfile?
  assignments         SportingAssignment[]
  externalIdentities  ExternalIdentity[]
  availabilityPeriods AvailabilityPeriod[]
  auditEvents         SecurityAuditEvent[] @relation("AuditTargetPerson")
  playerNotes         PlayerNote[]

  @@index([clubId, displayName])
}

model PlayerProfile {
  personId           String         @id
  preferredFoot      PreferredFoot?
  primaryPosition    Position?
  secondaryPositions Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  person             Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model StaffProfile {
  personId  String   @id
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Team {
  id            String               @id @default(cuid())
  clubId        String
  name          String
  categoryKey   String
  categoryLabel String
  ageGroupLabel String?
  minimumAge    Int?
  maximumAge    Int?
  legacyGroupId String?              @unique
  archivedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  club          Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  legacyGroup   PlayerGroup?         @relation(fields: [legacyGroupId], references: [id], onDelete: SetNull)
  teamSeasons   TeamSeason[]
  assignments   SportingAssignment[]
  playerNotesOrigin PlayerNote[]          @relation("PlayerNoteOriginTeam")
  playerNoteGrants PlayerNoteTeamGrant[]

  @@index([clubId, name])
  @@index([clubId, archivedAt])
}

model ClubSeason {
  id          String       @id @default(cuid())
  clubId      String
  name        String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  teamSeasons TeamSeason[]

  @@unique([clubId, name, startDate, endDate])
  @@index([clubId, startDate, endDate])
}

model TeamSeason {
  id            String               @id @default(cuid())
  clubId        String
  teamId        String
  clubSeasonId  String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  club          Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team          Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  clubSeason    ClubSeason           @relation(fields: [clubSeasonId], references: [id], onDelete: Cascade)
  legacySeasons Season[]
  assignments   SportingAssignment[]

  @@unique([teamId, clubSeasonId])
  @@index([clubId, clubSeasonId])
}

model FunctionalRole {
  id           String                   @id @default(cuid())
  clubId       String
  key          String
  name         String
  description  String?
  systemKey    FunctionalRoleSystemKey?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  club         Club                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  capabilities RoleCapability[]
  assignments  SportingAssignment[]

  @@unique([clubId, key])
  @@index([clubId, systemKey])
}

model RoleCapability {
  id               String             @id @default(cuid())
  roleDefinitionId String
  capability       SportingCapability
  createdAt        DateTime           @default(now())
  roleDefinition   FunctionalRole     @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)

  @@unique([roleDefinitionId, capability])
  @@index([capability])
}

model SportingAssignment {
  id               String                 @id @default(cuid())
  clubId           String
  personId         String
  teamId           String?
  teamSeasonId     String?
  roleDefinitionId String
  assignmentType   SportingAssignmentType
  validFrom        DateTime
  validTo          DateTime?
  reason           String?
  source           String?
  createdById      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  club             Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  person           Person                 @relation(fields: [personId], references: [id], onDelete: Cascade)
  team             Team?                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamSeason       TeamSeason?            @relation(fields: [teamSeasonId], references: [id], onDelete: SetNull)
  roleDefinition   FunctionalRole         @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict)
  createdBy        User?                  @relation("SportingAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clubId, personId, validFrom, validTo])
  @@index([teamId, validFrom, validTo])
  @@index([teamSeasonId, validFrom, validTo])
  @@index([roleDefinitionId])
}

model ExternalIdentity {
  id         String    @id @default(cuid())
  clubId     String
  personId   String
  provider   String
  externalId String
  source     String?
  validFrom  DateTime?
  validTo    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  club       Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  person     Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([clubId, provider, externalId])
  @@index([personId, provider])
}

model AvailabilityPeriod {
  id                 String                     @id @default(cuid())
  clubId             String
  personId           String
  status             SportingAvailabilityStatus
  validFrom          DateTime
  validTo            DateTime?
  restrictionSummary String?
  source             String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  club               Club                       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  person             Person                     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([clubId, personId, validFrom, validTo])
}

model PlayerNote {
  id             String                   @id @default(cuid())
  clubId         String
  personId       String
  originTeamId   String
  authorId       String
  category       PlayerNoteCategory
  body           String
  observedAt     DateTime
  followUpAt     DateTime?
  followUpStatus PlayerNoteFollowUpStatus?
  version        Int                      @default(1)
  archivedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  club           Club                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  person         Person                   @relation(fields: [personId], references: [id], onDelete: Cascade)
  originTeam     Team                     @relation("PlayerNoteOriginTeam", fields: [originTeamId], references: [id], onDelete: Restrict)
  author         User                     @relation("PlayerNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  revisions      PlayerNoteRevision[]
  teamGrants     PlayerNoteTeamGrant[]

  @@index([clubId, personId, archivedAt, observedAt, id])
  @@index([originTeamId, archivedAt, observedAt, id])
  @@index([authorId])
}

model PlayerNoteRevision {
  id             String                   @id @default(cuid())
  noteId         String
  version        Int
  category       PlayerNoteCategory
  body           String
  observedAt     DateTime
  followUpAt     DateTime?
  followUpStatus PlayerNoteFollowUpStatus?
  editedById     String
  createdAt      DateTime                 @default(now())
  note           PlayerNote               @relation(fields: [noteId], references: [id], onDelete: Cascade)
  editedBy       User                     @relation("PlayerNoteRevisionEditor", fields: [editedById], references: [id], onDelete: Restrict)

  @@unique([noteId, version])
  @@index([noteId, createdAt, id])
}

model PlayerNoteTeamGrant {
  id          String     @id @default(cuid())
  noteId      String
  teamId      String
  grantedById String
  createdAt   DateTime   @default(now())
  note        PlayerNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  grantedBy   User       @relation("PlayerNoteGrantActor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([noteId, teamId])
  @@index([teamId, noteId])
}

model PlayerGroup {
  id         String         @id @default(cuid())
  name       String
  clubId     String
  ageGroup   String
  archivedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  category   TeamCategory   @default(ALT_YAPI)
  members    GroupMember[]
  matches    Match[]        @relation("GroupMatches")
  seasons    Season[]       @relation("GroupSeasons")
  club       Club           @relation(fields: [clubId], references: [id])
  sessions   TrainingPlan[] @relation("GroupPlans")
  drills     Drill[]
  team       Team?
}

model GroupMember {
  id        String      @id @default(cuid())
  userId    String
  groupId   String
  createdAt DateTime    @default(now())
  group     PlayerGroup @relation(fields: [groupId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
}

model AccountInvitation {
  id             String    @id @default(cuid())
  email          String
  role           UserRole
  clubId         String?
  tokenHash      String    @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  createdById    String
  acceptedUserId String?   @unique
  createdAt      DateTime  @default(now())
  club           Club?     @relation(fields: [clubId], references: [id])
  createdBy      User      @relation("InvitationCreator", fields: [createdById], references: [id])
  acceptedUser   User?     @relation("InvitationAcceptedUser", fields: [acceptedUserId], references: [id])

  @@index([email])
  @@index([expiresAt])
  @@index([clubId])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  user        User      @relation("PasswordResetTarget", fields: [userId], references: [id])
  createdBy   User      @relation("PasswordResetCreator", fields: [createdById], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model SecurityAuditEvent {
  id             String              @id @default(cuid())
  action         SecurityAuditAction
  actorId        String?
  targetUserId   String?
  targetPersonId String?
  clubId         String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  actor          User?               @relation("AuditActor", fields: [actorId], references: [id])
  targetUser     User?               @relation("AuditTarget", fields: [targetUserId], references: [id])
  targetPerson   Person?             @relation("AuditTargetPerson", fields: [targetPersonId], references: [id], onDelete: SetNull)
  club           Club?               @relation(fields: [clubId], references: [id])

  @@index([actorId])
  @@index([targetUserId])
  @@index([targetPersonId])
  @@index([clubId])
  @@index([createdAt])
}

model RefreshSession {
  id                String    @id @default(cuid())
  userId            String
  familyId          String
  tokenHash         String    @unique
  authVersion       Int
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revocationReason  String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model Drill {
  id          String        @id @default(cuid())
  title       String
  category    DrillCategory
  ageGroup    String
  durationMin Int
  difficulty  Difficulty
  equipment   String?
  jsonData    Json
  imageUrl    String?
  scope       DrillScope    @default(GLOBAL)
  clubId      String?
  groupId     String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  plans       PlanDrill[]
  club        Club?         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  group       PlayerGroup?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("DrillCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions    DrillVersion[]

  @@index([scope, clubId])
  @@index([groupId])
  @@index([createdById])
}

model DrillSource {
  id                String            @id @default(cuid())
  kind              DrillSourceKind
  title             String
  sourceUrl         String?
  author            String?
  license           DrillLicenseType
  attribution       String?
  changes           String?
  licenseVerifiedAt DateTime?
  verifiedById      String?
  contentHash       String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  verifiedBy        User?             @relation("DrillSourceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  versions          DrillVersion[]

  @@index([kind, license])
}

model DrillVersion {
  id               String             @id @default(cuid())
  drillId          String
  version          Int
  status           DrillContentStatus @default(DRAFT)
  title            String
  summary          String
  category         DrillCategory
  difficulty       Difficulty
  objectiveKey     String
  objectiveLabel   String
  themes           String[]
  durationMin      Int
  playerMin        Int?
  playerMax        Int?
  areaLengthM      Int?
  areaWidthM       Int?
  equipmentItems   String[]
  organization     String
  steps            Json
  coachingPoints   Json
  progressions     Json
  regressions      Json
  constraints      Json
  safetyNotes      String?
  boardDocument    Json?
  searchText       String
  sourceId         String
  createdById      String?
  reviewedById     String?
  publishedById    String?
  reviewComment    String?
  submittedAt      DateTime?
  approvedAt       DateTime?
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  drill            Drill              @relation(fields: [drillId], references: [id], onDelete: Cascade)
  source           DrillSource        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  createdBy        User?              @relation("DrillVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy       User?              @relation("DrillVersionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedBy      User?              @relation("DrillVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  ageVariants      DrillAgeVariant[]

  @@unique([drillId, version])
  @@index([status, publishedAt])
  @@index([objectiveKey, category, difficulty])
  @@index([sourceId])
}

model DrillAgeVariant {
  id             String       @id @default(cuid())
  drillVersionId String
  ageGroup       String
  durationMin    Int
  playerMin      Int?
  playerMax      Int?
  areaLengthM    Int?
  areaWidthM     Int?
  rules          Json
  coachingPoints Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  drillVersion   DrillVersion @relation(fields: [drillVersionId], references: [id], onDelete: Cascade)

  @@unique([drillVersionId, ageGroup])
  @@index([ageGroup, durationMin, playerMin, playerMax])
}

model TrainingPlan {
  id            String       @id @default(cuid())
  title         String
  clubId        String
  coachId       String
  totalDuration Int          @default(0)
  groupId       String?
  date          DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  attendance    Attendance[]
  dayPlans      DayPlan[]
  drills        PlanDrill[]
  club          Club         @relation(fields: [clubId], references: [id])
  coach         User         @relation(fields: [coachId], references: [id])
  group         PlayerGroup? @relation("GroupPlans", fields: [groupId], references: [id])
}

model PlanDrill {
  id             String       @id @default(cuid())
  trainingPlanId String
  drillId        String
  phase          Phase
  order          Int          @default(0)
  notes          String?
  boardSnapshot  Json?
  drill          Drill        @relation(fields: [drillId], references: [id])
  trainingPlan   TrainingPlan @relation(fields: [trainingPlanId], references: [id])
}

model Attendance {
  id        String           @id @default(cuid())
  playerId  String
  planId    String
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  plan      TrainingPlan     @relation(fields: [planId], references: [id])
  player    User             @relation(fields: [playerId], references: [id])

  @@unique([planId, playerId])
}

model Season {
  id           String      @id @default(cuid())
  name         String
  clubId       String
  groupId      String
  startDate    DateTime
  endDate      DateTime
  userId       String
  teamSeasonId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  matches      Match[]
  club         Club        @relation(fields: [clubId], references: [id])
  group        PlayerGroup @relation("GroupSeasons", fields: [groupId], references: [id])
  createdBy    User        @relation("SeasonCreator", fields: [userId], references: [id])
  weeks        WeekPlan[]
  teamSeason   TeamSeason? @relation(fields: [teamSeasonId], references: [id], onDelete: SetNull)

  @@index([teamSeasonId])
}

model WeekPlan {
  id         String    @id @default(cuid())
  seasonId   String
  weekNumber Int
  startDate  DateTime
  endDate    DateTime
  notes      String?
  totalLoad  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  days       DayPlan[]
  season     Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, weekNumber])
}

model DayPlan {
  id             String        @id @default(cuid())
  weekId         String
  dayOfWeek      Int
  date           DateTime
  type           DayType       @default(TRAINING)
  title          String?
  trainingPlanId String?
  drillIds       Json?
  duration       Int?
  intensity      Int?
  notes          String?
  location       String?
  topic          String?
  opponent       String?
  competition    String?
  completed      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  trainingPlan   TrainingPlan? @relation(fields: [trainingPlanId], references: [id])
  week           WeekPlan      @relation(fields: [weekId], references: [id], onDelete: Cascade)
}

model Match {
  id               String       @id @default(cuid())
  seasonId         String
  date             DateTime
  opponent         String
  location         String
  competition      String?
  result           String?
  opponentAnalysis Json?
  ourFormation     String?
  notes            String?
  videoLinks       Json?
  tacticalBoard    Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  groupId          String?
  group            PlayerGroup? @relation("GroupMatches", fields: [groupId], references: [id])
  season           Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

model PlayerLoad {
  id             String   @id @default(cuid())
  playerId       String
  date           DateTime
  totalDistance  Float    @default(0)
  hsr            Float    @default(0)
  sprintDistance Float    @default(0)
  accelerations  Int      @default(0)
  wellness       Json?
  createdAt      DateTime @default(now())
  player         User     @relation("PlayerLoads", fields: [playerId], references: [id])
}

model PlayerPerformance {
  id                     String       @id @default(cuid())
  playerId               String?
  externalPlayerName     String?
  externalPlayerTeam     String?
  externalPlayerPosition String?
  analysisType           AnalysisType @default(INTERNAL)
  date                   DateTime     @default(now())
  speed                  Int          @default(0)
  technique              Int          @default(0)
  endurance              Int          @default(0)
  tactical               Int          @default(0)
  form                   Int          @default(0)
  rating                 Float        @default(0)
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  developmentPotential   Json?
  formConsistency        Json?
  healthStats            Json?
  matchImpactStats       Json?
  mentalStats            Json?
  physicalStats          Json?
  roleAnalysis           Json?
  summaryDetails         Json?
  tacticalStats          Json?
  technicalStats         Json?
  player                 User?        @relation(fields: [playerId], references: [id], onDelete: SetNull)
}

model VideoAnalysis {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  duration    String?
  clipsCount  Int      @default(0)
  category    String?
  tags        Json?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalysisReport {
  id         String   @id @default(cuid())
  name       String
  type       String
  category   String
  parameters Json?
  fileUrl    String?
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TeamPerformance {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  formation     String?
  passAccuracy  Int?
  possession    Int?
  shotsOnTarget Int?
  goalsScored   Int?
  goalsConceded Int?
  rating        Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ScoutingReport {
  id         String   @id @default(cuid())
  opponent   String
  date       DateTime @default(now())
  formation  String?
  strengths  Json?
  weaknesses Json?
  keyPlayers Json?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MatchAnalysis {
  id                String   @id @default(cuid())
  date              DateTime @default(now())
  opponent          String
  location          String?
  competition       String?
  result            String?
  ourFormation      String?
  opponentFormation String?
  possession        Int?
  passAccuracy      Int?
  shotsOnTarget     Int?
  goalsScored       Int?
  goalsConceded     Int?
  rating            Float    @default(0)
  notes             String?
  videoUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PlayerHealthLog {
  id                 String          @id @default(cuid())
  playerId           String
  status             HealthStatus // Main health status category
  severity           HealthSeverity? // Severity level if injured
  bodyPart           String? // Affected body part (e.g., "Sol Ayak", "Sağ Dizayn")
  expectedReturnDate DateTime? // Expected return date if injured
  notes              String? // Additional details
  createdAt          DateTime        @default(now())
  player             User            @relation("PlayerHealthLogs", fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([createdAt])
}

model PlayerHealthStatus {
  id                    String                 @id @default(cuid())
  playerId              String
  primaryStatus         PrimaryHealthStatus // 🟢 Sağlıklı, 🟡 Yük Kontrollü, 🟠 Hafif, 🔴 Orta, ⛔ Ciddi, 🏥 Rehabilitasyon, 🧊 Tedavi, 🏠 Maç Dışı, 🔒 Karantina
  injuryType            InjuryType? // Conditional: Muscle, Ligament, Tendon, Bone, Other
  muscleInjurySubtype   MuscleInjuryType? // Conditional: if injuryType = MUSCLE
  ligamentInjurySubtype LigamentInjuryType? // Conditional: if injuryType = LIGAMENT
  tendonInjurySubtype   TendonInjuryType? // Conditional: if injuryType = TENDON
  boneInjurySubtype     BoneInjuryType? // Conditional: if injuryType = BONE
  bodyPart              BodyPart? // Affected body part
  rehabPhase            RehabPhase? // Rehab stage: Acute, Light, Strength, Ball, PreMatch, FullClearance
  trainingParticipation TrainingParticipation? // Training status: Restricted, Separate, Partial, Full, MatchReady
  estimatedReturnDays   EstimatedReturnDays? // Estimated return timeline
  clinicalNotes         String? // Doctor/PT notes (textarea)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  player                User                   @relation("PlayerHealthStatus", fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([createdAt])
}

model PlayerCoachNote {
  id        String   @id @default(cuid())
  playerId  String
  note      String // Coach's note text
  createdAt DateTime @default(now())
  player    User     @relation("PlayerCoachNotes", fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([createdAt])
}

